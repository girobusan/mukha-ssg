{
  "name": "mukha-ssg",
  "version": "0.1.10",
  "description": "Minimalist static site generator",
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "alternativeRepository": {
    "type": "git",
    "url": "https://github.com/girobusan/mukha-ssg.git"
  },
  "keywords": [
    "ssg",
    "static",
    "static-site-generator"
  ],
  "bin": {
    "mukha-ssg": "dist/mukha.js",
    "latid2mukha": "dist/latid2mukha.js",
    "mukha": "dist/mukha.js"
  },
  "files": [
    "dist/mukha.js",
    "dist/oss-licenses.json",
    "dist/search_client.js"
  ],
  "scripts": {
    "test": "console.log('No tests')",
    "build": "npx webpack --mode production",
    "watch": "npm run prebuild ; npx webpack --mode development",
    "prebuild": "npx webpack -c prebuild.config.js --mode production",
    "watch_site": "cd site_tpl ; mukha-ssg -w",
    "dist": "node scripts/makedist.mjs",
    "postbuild": "shx chmod +x dist/mukha.js && shx chmod +x dist/latid2mukha.js ; shx cp LICENSE.txt dist/"
  },
  "babel": {
    "plugins": [
      [
        "htm"
      ]
    ]
  },
  "author": "girobusan",
  "license": "LGPL",
  "devDependencies": {
    "babel-core": "^6.26.3",
    "babel-loader": "^10.1.1",
    "babel-plugin-htm": "^3.0.0",
    "chokidar": "^3.6.0",
    "date-fns": "^4.1.0",
    "feed": "^5.1.0",
    "highlight.js": "^11.11.1",
    "htm": "^3.1.1",
    "html-webpack-plugin": "^5.5.0",
    "install": "^0.13.0",
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.1",
    "js-yaml": "^4.1.0",
    "lodash.throttle": "^4.1.1",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.14.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-small": "^1.0.0",
    "mini-css-extract-plugin": "^2.6.0",
    "nunjucks": "^3.2.4",
    "open": "^10.1.2",
    "papaparse": "^5.5.3",
    "path-browserify": "^1.0.1",
    "punycode": "^2.3.1",
    "readline-sync": "^1.4.10",
    "terser-webpack-plugin": "^5.3.14",
    "unidecode": "^1.1.0",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-license-plugin": "^4.5.1",
    "webpack-shell-plugin-next": "^2.3.2",
    "yoctocolors": "^2.1.1"
  }
}
